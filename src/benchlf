#!/usr/bin/env bash
# benchlf
# relative performance of top file finders, find, fd, and lf
directory="/home/bill"

a[1]="find $directory"
a[2]="fd . -H -I $directory"

red="[0;31m"
green="[0;32m"
reset="[0m"
echo baseline find, fd
for i in "${!a[@]}"; do
    echo ------------------------------------------------
    CommandStr="${a[$i]}"
    Command=$(echo $CommandStr | cut -d' ' -f1)
    echo $CommandStr
    /bin/time -o time.out $CommandStr | wc -l >wc.out
    grep -v "^Command" time.out
    if [ "$Command" = "find" ]; then
        expected=$(cat wc.out)
        expected=$(($expected - 1))
        echo "found $(cat wc.out) files"
    else
        if [ "expected" = "" ]; then
            echo found $(cat wc.out) files
        else
            echo -n "expected $expected files, "
            if [ "$expected" = "$(cat wc.out)" ]; then
                echo "found $(cat wc.out) files"
            else
                echo "$red"found $(cat wc.out) files"$reset"
            fi
        fi
    fi
done
echo ================================================
CommandStr="./lf -H $directory"
for i in 10 11 12 13 14 15 16; do
    echo $CommandStr -T$i
    /bin/time -o time.out $CommandStr -T$i | wc -l >wc.out
    grep -v "^Command" time.out
    echo -n "expected $expected, "
    if [ "$expected" = "$(cat wc.out)" ]; then
        echo "found $(cat wc.out) files"
    else
        echo "$red"found $(cat wc.out) files"$reset"
    fi
    echo ------------------------------------------------
done
rm time.out wc.out
